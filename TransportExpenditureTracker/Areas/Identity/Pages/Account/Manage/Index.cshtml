@page
@model IndexModel
@{ ViewData["Title"] = "Profile"; }

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-gear"></i> Profile</h4>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="table-container">
            <h5>Account Information</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">Full Name</dt>
                <dd class="col-sm-8">@Model.FullName</dd>
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>
            </dl>
        </div>
    </div>
</div>

<div class="mt-3">
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Dashboard")" method="post">
        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-box-arrow-right"></i> Sign Out</button>
    </form>
</div>