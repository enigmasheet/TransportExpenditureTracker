@model CsvPreviewViewModel
@{ ViewData["Title"] = "Import Expenses"; }

<h4 class="page-heading"><i class="bi bi-upload"></i> Import Expenses</h4><hr/>

@if (Model == null || Model.Rows == null || !Model.Rows.Any())
{
    <form asp-action="Import" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Upload CSV or Excel file</label>
            <input type="file" name="file" class="form-control" accept=".csv,.xlsx" required/>
        </div>
        <div class="form-check mb-3">
            <input type="checkbox" name="autoCreate" class="form-check-input" id="autoCreate" checked/>
            <label class="form-check-label" for="autoCreate">Auto-create missing suppliers & items</label>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-eye"></i> Preview</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
    </form>
}
else
{
    <div class="alert alert-info">
        Found @Model.Rows.Count rows
        (@Model.DuplicateCount duplicates, @Model.ErrorCount errors, @Model.WarningCount warnings)
    </div>

    @if (Model.WarningCount > 0)
    {
        <div class="alert alert-warning">
            <strong>@Model.WarningCount rows have data mismatches</strong> (VAT or Total amount doesn't match calculated value). They will be imported with server-calculated values.
        </div>
    }

    @if (Model.Errors?.Any() == true)
    {
        <div class="alert alert-warning"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
    }

    <form asp-action="ImportConfirm" method="post">
        <div class="table-container" style="max-height:400px;overflow:auto">
            <table class="table table-sm table-bordered">
                <thead><tr>
                    <th>Row</th><th>Miti</th><th>Fiscal Year</th><th>Invoice</th>
                    <th>Supplier</th><th>Item</th><th>Qty</th><th>Rate</th>
                    <th>Taxable</th><th>VAT</th><th>Total</th><th>Flags</th>
                </tr></thead>
                <tbody>
                    @for (int i = 0; i < Model.Rows.Count; i++)
                    {
                        var r = Model.Rows[i];
                        var rowClass = r.IsDuplicate || r.IsCrossRowDuplicate ? "table-warning" : r.ValidationError != null ? "table-danger" : "";
                        <tr class="@rowClass">
                            <td>@r.RowIndex</td>
                            <td>@r.Miti</td>
                            <td>@r.FiscalYearName</td>
                            <td>@r.InvoiceNo</td>
                            <td>@r.SupplierName</td>
                            <td>@r.ItemName</td>
                            <td>@r.Quantity</td>
                            <td>@r.Rate</td>
                            <td>@r.TaxableAmount</td>
                            <td>@r.VatAmount</td>
                            <td>@r.TotalAmount</td>
                            <td>
                                @if (r.IsDuplicate) { <span class="badge bg-warning">Dup</span> }
                                @if (r.IsCrossRowDuplicate) { <span class="badge bg-warning">Cross-Dup</span> }
                                @if (r.IsVatMismatch) { <span class="badge bg-info">VAT</span> }
                                @if (r.IsTotalMismatch) { <span class="badge bg-info">Total</span> }
                                @if (!string.IsNullOrEmpty(r.ValidationError)) { <span class="badge bg-danger">Error</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-success mt-3"><i class="bi bi-check-lg"></i> Confirm Import</button>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3"><i class="bi bi-x-lg"></i> Cancel</a>
    </form>
}
