@model ExpenseEntryViewModel
@inject TransportExpenditureTracker.Services.Interfaces.ICompanyService _companyService
@{
    ViewData["Title"] = "Edit Expense";
    var vatRate = await _companyService.GetVatRateAsync();
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-pencil"></i> Edit Expense</h4>
</div>
<form asp-action="Edit" asp-route-id="@Model.ExpenseId" method="post" id="batch-form">
    <input type="hidden" asp-for="ExpenseId" />
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="InvoiceNo" class="form-label"></label><input asp-for="InvoiceNo" class="form-control" required/><span asp-validation-for="InvoiceNo" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="Miti" class="form-label"></label><input asp-for="Miti" class="form-control nepali-datepicker" required/><span asp-validation-for="Miti" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="FiscalYearId" class="form-label"></label><select asp-for="FiscalYearId" class="form-control" asp-items="ViewBag.FiscalYears"><option value="">-- Select --</option></select><span asp-validation-for="FiscalYearId" class="text-danger"></span></div>
        <div class="col-md-3"><label class="form-label" for="NepaliMonth">Month</label><select asp-for="NepaliMonth" class="form-control" asp-items="ViewBag.NepaliMonths"><option value="">-- Select --</option></select></div>
        <div class="col-md-4"><label class="form-label" for="SupplierId">Supplier</label><select asp-for="SupplierId" class="form-control supplier-select" asp-items="ViewBag.Suppliers"><option value="">-- Select --</option></select></div>
        <div class="col-md-4"><label class="form-label" for="CategoryId">Category</label><select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"><option value="">-- Select --</option></select></div>
        <div class="col-md-4"><label class="form-label" for="PaymentMethod">Payment Method</label><select asp-for="PaymentMethod" class="form-control" asp-items="ViewBag.PaymentMethods"><option value="">-- Select --</option></select></div>
        <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="2"></textarea></div>
    </div>

    <h5 class="mt-4">Details</h5>
    <div class="table-container">
        <table class="table table-sm" id="details-table">
            <thead><tr><th>Item</th><th>Qty</th><th>Rate</th><th>Taxable</th><th>VAT</th><th>Total</th><th></th></tr></thead>
            <tbody>
                @if (Model.Details != null) {
                    for (int i = 0; i < Model.Details.Count; i++)
                    {
                        <tr class="expense-row">
                            <td><select asp-for="Details[i].ItemId" class="form-control form-control-sm item-select" asp-items="ViewBag.Items"><option value="">--</option></select></td>
                            <td><input asp-for="Details[i].Quantity" type="number" min="0" step="0.01" class="form-control form-control-sm qty" /></td>
                            <td><input asp-for="Details[i].Rate" type="number" min="0" step="0.01" class="form-control form-control-sm rate" /></td>
                            <td><input asp-for="Details[i].TaxableAmount" type="number" min="0" step="0.01" class="form-control form-control-sm taxable" /></td>
                            <td><input asp-for="Details[i].VatAmount" class="form-control form-control-sm vat" readonly /></td>
                            <td><input asp-for="Details[i].TotalAmount" class="form-control form-control-sm total" readonly /></td>
                            <td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bi bi-x"></i></button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <button type="button" id="add-row-btn" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i> Add Row</button>
    </div>
    <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-save"></i> Update</button>
    <a asp-action="Index" class="btn btn-outline-secondary mt-3"><i class="bi bi-x-lg"></i> Cancel</a>
</form>

@section Scripts {
    <script src="~/js/batch-entry.js" asp-append-version="true"></script>
    <script>
        BatchEntry.init({
            table: '#details-table',
            form: '#batch-form',
            addBtn: '#add-row-btn',
            removeBtn: null,
            addCount: 1,
            vatRate: @(vatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            useTemplateRow: false
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
