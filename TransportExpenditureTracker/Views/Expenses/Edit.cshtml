@model ExpenseEntryViewModel
@{ ViewData["Title"] = "Edit Expense"; }

<h4><i class="bi bi-pencil"></i> Edit Expense</h4><hr/>
<form asp-action="Edit" asp-route-id="@Model.ExpenseId" method="post">
    <input type="hidden" asp-for="ExpenseId" />
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="InvoiceNo" class="form-label"></label><input asp-for="InvoiceNo" class="form-control" required/><span asp-validation-for="InvoiceNo" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="Miti" class="form-label"></label><input asp-for="Miti" class="form-control nepali-datepicker" required/><span asp-validation-for="Miti" class="text-danger"></span></div>
        <div class="col-md-3"><label class="form-label">Fiscal Year</label><select asp-for="FiscalYear" class="form-control" asp-items="ViewBag.FiscalYears"><option value="">-- Select --</option></select></div>
        <div class="col-md-3"><label class="form-label">Month</label><select asp-for="NepaliMonth" class="form-control" asp-items="ViewBag.NepaliMonths"><option value="">-- Select --</option></select></div>
        <div class="col-md-4"><label class="form-label">Supplier</label><select asp-for="SupplierId" class="form-control supplier-select" asp-items="ViewBag.Suppliers"><option value="">-- Select --</option></select></div>
        <div class="col-md-4"><label class="form-label">Category</label><select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"><option value="">-- Select --</option></select></div>
        <div class="col-md-4"><label class="form-label">Payment Method</label><select asp-for="PaymentMethod" class="form-control" asp-items="ViewBag.PaymentMethods"><option value="">-- Select --</option></select></div>
        <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="2"></textarea></div>
    </div>

    <h5 class="mt-4">Details</h5>
    <div class="table-container">
        <table class="table table-sm" id="details-table">
            <thead><tr><th>Item</th><th>Qty</th><th>Rate</th><th>Taxable</th><th>VAT</th><th>Total</th><th></th></tr></thead>
            <tbody>
                @if (Model.Details != null) {
                    for (int i = 0; i < Model.Details.Count; i++)
                    {
                        <tr class="expense-row">
                            <td><select asp-for="Details[i].ItemId" class="form-control form-control-sm item-select" asp-items="ViewBag.Items"><option value="">--</option></select></td>
                            <td><input asp-for="Details[i].Quantity" class="form-control form-control-sm qty" /></td>
                            <td><input asp-for="Details[i].Rate" class="form-control form-control-sm rate" /></td>
                            <td><input asp-for="Details[i].TaxableAmount" class="form-control form-control-sm taxable" /></td>
                            <td><input asp-for="Details[i].VatAmount" class="form-control form-control-sm vat" readonly /></td>
                            <td><input asp-for="Details[i].TotalAmount" class="form-control form-control-sm total" readonly /></td>
                            <td><button type="button" class="btn btn-sm btn-danger remove-row" onclick="removeRow(this)"><i class="bi bi-x"></i></button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <button type="button" id="add-row-btn" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i> Add Row</button>
    </div>
    <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-save"></i> Update</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>

@section Scripts {
    <script src="~/js/expense-entry.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            $('.supplier-select').select2({ width: '100%' });
            $('.item-select').select2({ width: '100%' });
            $('.nepali-datepicker').nepaliDatePicker({ dateFormat: '%y-%m-%d', ndpYear: true, ndpMonth: true, ndpYearCount: 100 });
        });
    </script>
}
