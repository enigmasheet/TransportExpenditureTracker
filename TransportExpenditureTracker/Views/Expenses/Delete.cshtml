@model ExpenseEntryViewModel
@{ ViewData["Title"] = "Delete Expense"; }

<h4 class="page-heading"><i class="bi bi-trash"></i> Delete Expense</h4>
<div class="delete-confirm d-flex align-items-center gap-3 mt-3">
    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
    <div>
        <strong>Are you sure?</strong><br/>
        <span class="text-muted">This action cannot be undone. The expense and all its line items will be permanently removed.</span>
    </div>
</div>
<hr/>

<div class="row g-3 mb-4">
    <div class="col-md-3"><label class="fw-bold">Invoice No</label><p>@Model.InvoiceNo</p></div>
    <div class="col-md-3"><label class="fw-bold">Miti</label><p>@Model.Miti</p></div>
    <div class="col-md-3"><label class="fw-bold">Fiscal Year</label><p>@Model.FiscalYear</p></div>
    <div class="col-md-3"><label class="fw-bold">Month</label><p>@Model.NepaliMonth</p></div>
    <div class="col-md-4"><label class="fw-bold">Supplier</label><p>@ViewBag.SupplierName</p></div>
    <div class="col-md-4"><label class="fw-bold">Category</label><p>@ViewBag.CategoryName</p></div>
    <div class="col-md-4"><label class="fw-bold">Payment Method</label><p>@Model.PaymentMethod</p></div>
    @if (!string.IsNullOrEmpty(Model.Remarks))
    {
        <div class="col-12"><label class="fw-bold">Remarks</label><p>@Model.Remarks</p></div>
    }
</div>

<h5>Details</h5>
<div class="table-container">
    <table class="table table-sm table-bordered">
        <thead><tr><th>#</th><th>Item</th><th>Qty</th><th>Rate</th><th>Taxable</th><th>VAT</th><th>Total</th></tr></thead>
        <tbody>
            @if (Model.Details != null)
            {
                var index = 1;
                foreach (var d in Model.Details)
                {
                    <tr>
                        <td>@(index++)</td>
                        <td>@d.ItemName</td>
                        <td>@d.Quantity</td>
                        <td>@d.Rate.ToString("N2")</td>
                        <td>@d.TaxableAmount.ToString("N2")</td>
                        <td>@d.VatAmount.ToString("N2")</td>
                        <td>@d.TotalAmount.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<form asp-action="Delete" asp-route-id="@Model.ExpenseId" method="post">
    <input type="hidden" asp-for="ExpenseId" />
    <button type="submit" class="btn btn-danger mt-3"><i class="bi bi-trash"></i> Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary mt-3"><i class="bi bi-x-lg"></i> Cancel</a>
</form>
