@model List<ExpenseHeaderViewModel>
@{ ViewData["Title"] = "Expenses"; }

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-receipt"></i> @ViewData["Title"]</h4>
    <div>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New Expense</a>
        <a asp-action="Import" class="btn btn-info btn-sm"><i class="bi bi-upload"></i> Import</a>
    </div>
</div>

<div class="table-container">
    <table class="table table-hover" id="expenses-table">
        <thead><tr><th>Invoice No</th><th>Miti</th><th>Supplier</th><th>Category</th><th>Payment</th><th>Created</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InvoiceNo</td>
                    <td>@item.Miti</td>
                    <td>@item.SupplierName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.PaymentMethod</td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.ExpenseId" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@item.ExpenseId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.ExpenseId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>$(document).ready(function() { $('#expenses-table').DataTable({ order: [[5, 'desc']], language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." } }); });</script>
}
