@model ExpenseBatchViewModel
@{ ViewData["Title"] = "Batch Expense Entry"; }

<h4 class="page-heading"><i class="bi bi-plus-circle"></i> Batch Expense Entry</h4>
<p class="text-muted">Enter all expenses for a specific fiscal year and month. Each row creates one expense record.</p>
<hr/>

<form asp-action="Create" method="post">
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FiscalYearId" class="form-label"></label>
                    <select asp-for="FiscalYearId" class="form-select" asp-items="ViewBag.FiscalYears">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="FiscalYearId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NepaliMonth" class="form-label">Month</label>
                    <select asp-for="NepaliMonth" class="form-select" asp-items="ViewBag.NepaliMonths">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="NepaliMonth" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-2">
        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quickSupplierModal">
            <i class="bi bi-person-plus"></i> Quick Add Supplier
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quickItemModal">
            <i class="bi bi-box-plus"></i> Quick Add Item
        </button>
    </div>

    <div class="table-container" style="max-height:500px;overflow:auto">
        <table class="table table-sm table-bordered" id="batch-table"
               data-supplier-search-url="@Url.Action("SearchJson", "Suppliers")">
            <thead class="table-dark">
                <tr>
                    <th style="width:30px">#</th>
                    <th style="width:110px">Miti</th>
                    <th style="width:100px">Invoice No</th>
                    <th style="width:180px">Supplier</th>
                    <th style="width:140px">Item</th>
                    <th style="width:70px">Qty</th>
                    <th style="width:70px">Rate</th>
                    <th style="width:90px">Taxable</th>
                    <th style="width:80px">VAT</th>
                    <th style="width:90px">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows is not null)
                {
                    for (int i = 0; i < Model.Rows.Count; i++)
                    {
                        var r = Model.Rows[i];
                        <tr class="@(i == 0 ? "template-row" : "data-row")">
                            <td class="row-num align-middle text-center">@(i + 1)</td>
                            <td>
                                <input asp-for="Rows[i].Miti" class="form-control form-control-sm nepali-datepicker" placeholder="YY/MM/DD" />
                                <span asp-validation-for="Rows[i].Miti" class="text-danger small"></span>
                            </td>
                            <td>
                                <input asp-for="Rows[i].InvoiceNo" class="form-control form-control-sm" placeholder="Invoice #" />
                                <span asp-validation-for="Rows[i].InvoiceNo" class="text-danger small"></span>
                            </td>
                            <td>
                                <select asp-for="Rows[i].SupplierId" class="form-control form-control-sm supplier-select"
                                        asp-items="ViewBag.Suppliers">
                                    <option value="">--</option>
                                </select>
                                <span asp-validation-for="Rows[i].SupplierId" class="text-danger small"></span>
                            </td>
                            <td>
                                <select asp-for="Rows[i].ItemId" class="form-control form-control-sm item-select"
                                        asp-items="ViewBag.Items">
                                    <option value="">--</option>
                                </select>
                                <span asp-validation-for="Rows[i].ItemId" class="text-danger small"></span>
                            </td>
                            <td>
                                <input asp-for="Rows[i].Quantity" class="form-control form-control-sm qty" />
                            </td>
                            <td>
                                <input asp-for="Rows[i].Rate" class="form-control form-control-sm rate" />
                            </td>
                            <td class="align-middle text-end computed-taxable">—</td>
                            <td class="align-middle text-end computed-vat">—</td>
                            <td class="align-middle text-end computed-total">—</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mt-2 d-flex gap-2">
        <button type="button" id="add-rows-btn" class="btn btn-sm btn-success">
            <i class="bi bi-plus-lg"></i> Add 5 Rows
        </button>
        <button type="button" id="remove-row-btn" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-dash-lg"></i> Remove Last Row
        </button>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save All Expenses</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
</form>

<!-- Quick Create Supplier Modal -->
<div class="modal fade" id="quickSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="quickSupplierForm">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-person-plus text-primary"></i> Quick Add Supplier</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">@await Html.PartialAsync("~/Views/Suppliers/_SupplierForm.cshtml", new SupplierViewModel())</div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Save</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Quick Create Item Modal -->
<div class="modal fade" id="quickItemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="quickItemForm">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-box-plus text-primary"></i> Quick Add Item</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">@await Html.PartialAsync("~/Views/Items/_ItemForm.cshtml", new ItemViewModel())</div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Save</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/batch-entry.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('.supplier-select').select2({
                ajax: {
                    url: '@Url.Action("SearchJson", "Suppliers")',
                    dataType: 'json',
                    delay: 300,
                    data: function (params) { return { term: params.term }; },
                    processResults: function (data) { return { results: data.results }; }
                },
                placeholder: 'Type name or VAT...',
                minimumInputLength: 1,
                width: '100%',
                allowClear: true
            });

            $('.item-select').select2({ placeholder: '-- Select Item --', allowClear: true, width: '100%' });
            $('.nepali-datepicker').nepaliDatePicker({ dateFormat: '%y-%m-%d', ndpYear: true, ndpMonth: true, ndpYearCount: 100 });

            // Quick Create Supplier
            $('#quickSupplierForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('button[type="submit"]');
                $btn.loading(true);
                $.ajax({
                    url: '@Url.Action("QuickCreate", "Suppliers")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        supplierName: $form.find('[name="SupplierName"]').val(),
                        location: $form.find('[name="Location"]').val(),
                        vatNo: $form.find('[name="VatNo"]').val()
                    }),
                    headers: { 'RequestVerificationToken': $form.find('[name="__RequestVerificationToken"]').val() }
                }).done(function (data) {
                    if (data.success) {
                        $('.supplier-select').append(new Option(data.text, data.id, true, true)).trigger('change');
                        $('#quickSupplierModal').modal('hide');
                        $form[0].reset();
                        showToast('success', 'Supplier "' + data.text + '" created.');
                    } else {
                        var msgs = [];
                        $.each(data.errors, function (f, arr) { msgs.push(arr.join(', ')); });
                        showToast('error', msgs.join('<br>'));
                    }
                }).fail(function () { showToast('error', 'Failed to create supplier.'); })
                  .always(function () { $btn.loading(false); });
            });

            // Quick Create Item
            $('#quickItemForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('button[type="submit"]');
                $btn.loading(true);
                $.ajax({
                    url: '@Url.Action("QuickCreate", "Items")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        itemName: $form.find('[name="ItemName"]').val(),
                        unit: $form.find('[name="Unit"]').val()
                    }),
                    headers: { 'RequestVerificationToken': $form.find('[name="__RequestVerificationToken"]').val() }
                }).done(function (data) {
                    if (data.success) {
                        $('.item-select').append(new Option(data.text, data.id, true, true)).trigger('change');
                        $('#quickItemModal').modal('hide');
                        $form[0].reset();
                        showToast('success', 'Item "' + data.text + '" created.');
                    } else {
                        var msgs = [];
                        $.each(data.errors, function (f, arr) { msgs.push(arr.join(', ')); });
                        showToast('error', msgs.join('<br>'));
                    }
                }).fail(function () { showToast('error', 'Failed to create item.'); })
                  .always(function () { $btn.loading(false); });
            });

            // Reset modal forms on hide
            $('#quickSupplierModal, #quickItemModal').on('hidden.bs.modal', function () {
                $(this).find('form')[0].reset();
            });
        });
    </script>
}