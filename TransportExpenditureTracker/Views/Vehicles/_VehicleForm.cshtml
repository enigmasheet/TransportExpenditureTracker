@model VehicleViewModel

<div class="row g-2">
    <div class="col-md-6">
        <div class="mb-2">
            <label asp-for="VehicleNumber" class="form-label"></label>
            <input asp-for="VehicleNumber" class="form-control" required />
            <span asp-validation-for="VehicleNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-2">
            <label asp-for="Type" class="form-label"></label>
            <input asp-for="Type" class="form-control" placeholder="e.g. Truck, Van, Bike" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-2">
            <label asp-for="Make" class="form-label"></label>
            <input asp-for="Make" class="form-control" />
            <span asp-validation-for="Make" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-2">
            <label asp-for="Model" class="form-label"></label>
            <input asp-for="Model" class="form-control" />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-2">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" class="form-control" />
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-8">
        <div class="mb-2">
            <label asp-for="AssignedDriverId" class="form-label"></label>
            <select asp-for="AssignedDriverId" class="form-control" asp-items="ViewBag.Drivers">
                <option value="">-- Select Driver --</option>
            </select>
            <span asp-validation-for="AssignedDriverId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-2">
            <label asp-for="EngineNumber" class="form-label"></label>
            <input asp-for="EngineNumber" class="form-control" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-2">
            <label asp-for="ChassisNumber" class="form-label"></label>
            <input asp-for="ChassisNumber" class="form-control" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-2">
            <label asp-for="CurrentMeterReading" class="form-label"></label>
            <input asp-for="CurrentMeterReading" class="form-control" />
        </div>
    </div>
    <div class="col-md-6 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
</div>