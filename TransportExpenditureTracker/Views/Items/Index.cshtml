@model List<ItemViewModel>
@{
    ViewData["Title"] = "Items";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-box"></i> @ViewData["Title"]</h4>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createItemModal"><i class="bi bi-plus-lg"></i> Add Item</button>
</div>

<div class="table-container">
    <table class="table table-sm table-bordered" id="items-table">
        <thead>
            <tr>
                <th>Item Name</th>
                <th>Unit</th>
                <th class="text-center">Used In</th>
                <th style="width:120px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Unit</td>
                    <td class="text-center">@item.ExpenseCount</td>
                    <td>
                        <button type="button" class="btn btn-outline-primary btn-icon" title="Edit" data-bs-toggle="modal" data-bs-target="#editItemModal" data-id="@item.ItemId"><i class="bi bi-pencil"></i></button>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" class="btn btn-outline-danger btn-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteItemModal" data-id="@item.ItemId"><i class="bi bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-box"></i>
            <h6>No items found</h6>
            <p>Add an item to get started.</p>
        </div>
    }
</div>

@{
    Func<object, object> createBody = @<text>@await Html.PartialAsync("~/Views/Items/_ItemForm.cshtml", new ItemViewModel())</text>;
    Func<object, object> spinnerBody = @<text><div class="text-center py-3"><div class="spinner-border" role="status"></div></div></text>;
}
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "createItemModal", FormId = "createItemForm", Title = "<i class='bi bi-plus-lg text-primary'></i> Add Item", BodyContent = createBody })
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "editItemModal", FormId = "editItemForm", Title = "<i class='bi bi-pencil text-warning'></i> Edit Item", SubmitText = "Update", BodyContent = spinnerBody })
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "deleteItemModal", FormId = "deleteItemForm", Title = "<i class='bi bi-trash text-danger'></i> Delete Item", SubmitText = "Delete", SubmitIcon = "bi-trash", SubmitClass = "btn-danger", BodyContent = spinnerBody })

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#items-table').DataTable({
                ordering: true,
                pageLength: 25,
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });

            ModalForm.initCreate({
                modalId: 'createItemModal',
                formId: 'createItemForm',
                submitUrl: '@Url.Action("Create", "Items")'
            });

            ModalForm.initDynamic({
                modalId: 'editItemModal',
                formId: 'editItemForm',
                loadUrl: '@Url.Action("GetForEdit", "Items")',
                submitUrl: '@Url.Action("QuickUpdate", "Items")'
            });

            ModalForm.initDynamic({
                modalId: 'deleteItemModal',
                formId: 'deleteItemForm',
                loadUrl: '@Url.Action("GetDeleteInfo", "Items")',
                submitUrl: '@Url.Action("QuickDelete", "Items")'
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
