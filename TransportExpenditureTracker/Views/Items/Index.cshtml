@model List<ItemViewModel>
@{
    ViewData["Title"] = "Items";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-box"></i> @ViewData["Title"]</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Item</a>
</div>

<div class="table-container">
    <table class="table table-sm table-bordered" id="items-table">
        <thead>
            <tr>
                <th>Item Name</th>
                <th>Unit</th>
                <th style="width:120px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Unit</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ItemId" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.ItemId" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#items-table').DataTable({
                ordering: true,
                pageLength: 25,
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });
        });
    </script>
}
