@model SupplierViewModel
@{
    ViewData["Title"] = "Delete Supplier";
}

<h5>@ViewData["Title"]</h5>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this supplier?
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Supplier Name</dt>
            <dd class="col-sm-8">@Model.SupplierName</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.Location</dd>

            <dt class="col-sm-4">VAT No</dt>
            <dd class="col-sm-8">@Model.VatNo</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="SupplierId" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
        </form>
    </div>
</div>
