@model List<SupplierViewModel>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-people"></i> @ViewData["Title"]</h4>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createSupplierModal"><i class="bi bi-plus-lg"></i> Add Supplier</button>
</div>

<div class="table-container">
    <table class="table table-sm table-bordered" id="suppliers-table">
        <thead>
            <tr>
                <th>Supplier Name</th>
                <th>Location</th>
                <th>VAT No</th>
                <th class="text-center">Expenses</th>
                <th style="width:120px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplierName</td>
                    <td>@item.Location</td>
                    <td>@item.VatNo</td>
                    <td class="text-center">@item.ExpenseCount</td>
                    <td>
                        <button type="button" class="btn btn-outline-primary btn-icon" title="Edit" data-bs-toggle="modal" data-bs-target="#editSupplierModal" data-id="@item.SupplierId"><i class="bi bi-pencil"></i></button>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" class="btn btn-outline-danger btn-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteSupplierModal" data-id="@item.SupplierId"><i class="bi bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <h6>No suppliers found</h6>
            <p>Add a supplier to get started.</p>
        </div>
    }
</div>

@{
    Func<object, object> createBody = @<text>@await Html.PartialAsync("~/Views/Suppliers/_SupplierForm.cshtml", new SupplierViewModel())</text>;
    Func<object, object> spinnerBody = @<text><div class="text-center py-3"><div class="spinner-border" role="status"></div></div></text>;
}
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "createSupplierModal", FormId = "createSupplierForm", Title = "<i class='bi bi-plus-lg text-primary'></i> Add Supplier", BodyContent = createBody })
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "editSupplierModal", FormId = "editSupplierForm", Title = "<i class='bi bi-pencil text-warning'></i> Edit Supplier", SubmitText = "Update", BodyContent = spinnerBody })
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "deleteSupplierModal", FormId = "deleteSupplierForm", Title = "<i class='bi bi-trash text-danger'></i> Delete Supplier", SubmitText = "Delete", SubmitIcon = "bi-trash", SubmitClass = "btn-danger", BodyContent = spinnerBody })

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#suppliers-table').DataTable({
                ordering: true,
                pageLength: 25,
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });

            ModalForm.initCreate({
                modalId: 'createSupplierModal',
                formId: 'createSupplierForm',
                submitUrl: '@Url.Action("Create", "Suppliers")'
            });

            ModalForm.initDynamic({
                modalId: 'editSupplierModal',
                formId: 'editSupplierForm',
                loadUrl: '@Url.Action("GetForEdit", "Suppliers")',
                submitUrl: '@Url.Action("QuickUpdate", "Suppliers")'
            });

            ModalForm.initDynamic({
                modalId: 'deleteSupplierModal',
                formId: 'deleteSupplierForm',
                loadUrl: '@Url.Action("GetDeleteInfo", "Suppliers")',
                submitUrl: '@Url.Action("QuickDelete", "Suppliers")'
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
