@model List<SupplierViewModel>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-people"></i> @ViewData["Title"]</h4>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createSupplierModal"><i class="bi bi-plus-lg"></i> Add Supplier</button>
</div>

<div class="table-container">
    <table class="table table-sm table-bordered" id="suppliers-table">
        <thead>
            <tr>
                <th>Supplier Name</th>
                <th>Location</th>
                <th>VAT No</th>
                <th style="width:120px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplierName</td>
                    <td>@item.Location</td>
                    <td>@item.VatNo</td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editSupplierModal" data-id="@item.SupplierId"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteSupplierModal" data-id="@item.SupplierId" data-name="@item.SupplierName"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createSupplierForm">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-plus-lg text-primary"></i> Add Supplier</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">@await Html.PartialAsync("_SupplierForm.cshtml", new SupplierViewModel())</div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Save</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editSupplierForm">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-pencil text-warning"></i> Edit Supplier</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body"><div class="text-center py-3"><div class="spinner-border" role="status"></div></div></div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Update</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteSupplierForm">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-trash text-danger"></i> Delete Supplier</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body"><div class="text-center py-3"><div class="spinner-border" role="status"></div></div></div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#suppliers-table').DataTable({
                ordering: true,
                pageLength: 25,
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });

            // Create
            $('#createSupplierForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                if (!$form.valid()) return;
                var $btn = $form.find('button[type="submit"]');
                $btn.loading(true);
                $.ajax({
                    url: '@Url.Action("Create", "Suppliers")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        supplierName: $form.find('[name="SupplierName"]').val(),
                        location: $form.find('[name="Location"]').val(),
                        vatNo: $form.find('[name="VatNo"]').val()
                    }),
                    headers: { 'RequestVerificationToken': $form.find('[name="__RequestVerificationToken"]').val() }
                }).done(function (data) {
                    if (data.success) {
                        $('#createSupplierModal').modal('hide');
                        $form[0].reset();
                        showToast('success', 'Supplier created.');
                        setTimeout(function () { location.reload(); }, 500);
                    } else {
                        var msgs = [];
                        $.each(data.errors, function (f, arr) { msgs.push(arr.join(', ')); });
                        showToast('error', msgs.join('<br>'));
                    }
                }).fail(function () { showToast('error', 'Failed to create supplier.'); })
                  .always(function () { $btn.loading(false); });
            });

            // Edit - load content
            $('#editSupplierModal').on('show.bs.modal', function (e) {
                var id = $(e.relatedTarget).data('id');
                var $body = $(this).find('.modal-body');
                $body.html('<div class="text-center py-3"><div class="spinner-border" role="status"></div></div>');
                $.get('@Url.Action("GetForEdit", "Suppliers")/' + id, function (html) {
                    $body.html(html);
                    $.validator.unobtrusive.parse($body);
                });
            });

            $('#editSupplierForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                if (!$form.valid()) return;
                var $btn = $form.find('button[type="submit"]');
                var $body = $form.closest('.modal').find('.modal-body');
                $btn.loading(true);
                $.ajax({
                    url: '@Url.Action("QuickUpdate", "Suppliers")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        supplierId: $body.find('[name="SupplierId"]').val(),
                        supplierName: $body.find('[name="SupplierName"]').val(),
                        location: $body.find('[name="Location"]').val(),
                        vatNo: $body.find('[name="VatNo"]').val()
                    }),
                    headers: { 'RequestVerificationToken': $form.find('[name="__RequestVerificationToken"]').val() }
                }).done(function (data) {
                    if (data.success) {
                        $('#editSupplierModal').modal('hide');
                        showToast('success', 'Supplier updated.');
                        setTimeout(function () { location.reload(); }, 500);
                    } else {
                        var msgs = [];
                        $.each(data.errors, function (f, arr) { msgs.push(arr.join(', ')); });
                        showToast('error', msgs.join('<br>'));
                    }
                }).fail(function () { showToast('error', 'Failed to update supplier.'); })
                  .always(function () { $btn.loading(false); });
            });

            // Delete - load content
            $('#deleteSupplierModal').on('show.bs.modal', function (e) {
                var id = $(e.relatedTarget).data('id');
                var $body = $(this).find('.modal-body');
                $body.html('<div class="text-center py-3"><div class="spinner-border" role="status"></div></div>');
                $.get('@Url.Action("GetDeleteInfo", "Suppliers")/' + id, function (html) {
                    $body.html(html);
                });
            });

            $('#deleteSupplierForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('button[type="submit"]');
                var id = $('#deleteSupplierModal').data('currentId');
                $btn.loading(true);
                $.ajax({
                    url: '@Url.Action("QuickDelete", "Suppliers")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ id: id }),
                    headers: { 'RequestVerificationToken': $form.find('[name="__RequestVerificationToken"]').val() }
                }).done(function (data) {
                    if (data.success) {
                        $('#deleteSupplierModal').modal('hide');
                        showToast('success', 'Supplier deleted.');
                        setTimeout(function () { location.reload(); }, 500);
                    } else {
                        showToast('error', 'Failed to delete supplier.');
                    }
                }).fail(function () { showToast('error', 'Failed to delete supplier.'); })
                  .always(function () { $btn.loading(false); });
            });

            // Store current id for delete
            $('#deleteSupplierModal').on('show.bs.modal', function (e) {
                $(this).data('currentId', $(e.relatedTarget).data('id'));
            });

            // Reset create modal on hide
            $('#createSupplierModal').on('hidden.bs.modal', function () {
                $(this).find('form')[0].reset();
            });
        });
    </script>
}
