@model List<SupplierViewModel>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-people"></i> @ViewData["Title"]</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Supplier</a>
</div>

<div class="table-container">
    <table class="table table-sm table-bordered" id="suppliers-table">
        <thead>
            <tr>
                <th>Supplier Name</th>
                <th>Location</th>
                <th>VAT No</th>
                <th style="width:120px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplierName</td>
                    <td>@item.Location</td>
                    <td>@item.VatNo</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#suppliers-table').DataTable({
                ordering: true,
                pageLength: 25,
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });
        });
    </script>
}
