@inject TransportExpenditureTracker.Services.Interfaces.ICompanyService _companyService
@inject TransportExpenditureTracker.Services.Interfaces.IFiscalCalendarService _fiscalService
@{
    var company = await _companyService.GetAsync();
    var fyName = _fiscalService.GetFiscalYearName(DateTime.Today);
    var reportTitle = ViewData["ReportTitle"] as string ?? ViewData["Title"] as string;
}
@if (company is not null || !string.IsNullOrEmpty(reportTitle))
{
    <div class="report-header mb-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h5 class="mb-0 fw-semibold">@(company?.Name ?? reportTitle)</h5>
                @if (company is not null)
                {
                    <small class="text-muted">
                        @string.Join(" | ", new[]
                        {
                            company.Address,
                            company.PanNumber is null ? null : $"PAN: {company.PanNumber}",
                            company.VatNumber is null ? null : $"VAT: {company.VatNumber}",
                            company.Phone
                        }.Where(s => !string.IsNullOrEmpty(s)))
                    </small>
                }
            </div>
            <div class="text-end">
                @if (!string.IsNullOrEmpty(reportTitle))
                {
                    <span class="badge bg-primary">@reportTitle</span>
                }
                @if (!string.IsNullOrEmpty(fyName))
                {
                    <div><small class="text-muted">Fiscal Year @fyName B.S.</small></div>
                }
            </div>
        </div>
    </div>
}