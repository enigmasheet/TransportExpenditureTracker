@model ModalFormConfig

<div class="modal fade" id="@Model.ModalId" tabindex="-1">
    <div class="modal-dialog @Model.DialogClass">
        <div class="modal-content">
            <form id="@Model.FormId">
                @if (Model.IncludeAntiforgery) { @Html.AntiForgeryToken() }
                <div class="modal-header">
                    <h5 class="modal-title">@Model.Title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (Model.BodyContent != null) { @Model.BodyContent(null!) }
                    else { <div class="text-center py-3"><output class="spinner-border"></output></div> }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn @Model.SubmitClass"><i class="bi @Model.SubmitIcon"></i> @Model.SubmitText</button>
                </div>
            </form>
        </div>
    </div>
</div>