@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="text-center py-5">
    <h1 class="text-danger display-4">Oops!</h1>
    <p class="lead">Something went wrong. Please try again.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">Back to Dashboard</a>
</div>
