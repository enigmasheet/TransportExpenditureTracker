@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="section-title">
    <h4 class="page-heading text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Error</h4>
</div>
<div class="text-center py-4">
    <p class="lead">Something went wrong. Please try again.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3"><i class="bi bi-speedometer2"></i> Back to Dashboard</a>
</div>
