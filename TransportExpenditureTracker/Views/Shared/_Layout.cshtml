<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TransportExpenditureTracker</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://code.jquery.com">
    <link rel="preconnect" href="https://unpkg.com">
    <link rel="dns-prefetch" href="https://cdn.datatables.net">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/nepali-date-picker@2.0.1/dist/nepaliDatePicker.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/2.2.2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransportExpenditureTracker.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-truck"></i> TransportExpenditureTracker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Expenses" asp-action="Index"><i class="bi bi-receipt"></i> Expenses</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-people"></i> Suppliers</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Items" asp-action="Index"><i class="bi bi-box"></i> Items</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ExpenseCategories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a>
                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header">Time-based</h6></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Daily">Daily</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Monthly">Monthly</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="FiscalYear">Fiscal Year</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">By Dimension</h6></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="SupplierWise">Supplier-wise</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="CategoryWise">Category-wise</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="ItemWise">Item-wise</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="PaymentMethod">Payment Method</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="LocationWise">Location-wise</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Financial</h6></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="VatPaid">VAT Paid</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="DetailedLedger">Detailed Ledger</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Exports" asp-action="Index"><i class="bi bi-envelope-paper"></i> Exports</a></li>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="RoleManagement" asp-action="Index"><i class="bi bi-shield-lock"></i> Manage</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @if (ViewData["Breadcrumbs"] is List<(string Label, string? Url)> crumbs && crumbs.Count > 1)
    {
        <div class="breadcrumb-bar">
            <div class="container-fluid">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        @foreach (var crumb in crumbs)
                        {
                            if (!string.IsNullOrEmpty(crumb.Url) && crumb != crumbs.Last())
                            {
                                <li class="breadcrumb-item"><a href="@crumb.Url">@crumb.Label</a></li>
                            }
                            else
                            {
                                <li class="breadcrumb-item active">@crumb.Label</li>
                            }
                        }
                    </ol>
                </nav>
            </div>
        </div>
    }

    <div class="container-fluid py-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light py-3">
        <div class="container-fluid text-center">
            &copy; @DateTime.Now.Year - TransportExpenditureTracker
        </div>
    </footer>

    <div class="toast-container" id="toastContainer"></div>
    <div id="tempData" data-success="@TempData["Success"]" data-error="@TempData["Error"]" style="display:none"></div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/nepali-date-picker@2.0.1/dist/jquery.nepaliDatePicker.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
