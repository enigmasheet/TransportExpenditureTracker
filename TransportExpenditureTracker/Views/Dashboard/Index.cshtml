@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var fy = Model.SelectedFiscalYear;
}

<div class="section-title mb-4">
    <h4 class="page-heading"><i class="bi bi-speedometer2"></i> Dashboard</h4>
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="form-label mb-0 text-nowrap" for="fiscalYear">Fiscal Year:</label>
        <select name="fiscalYear" id="fiscalYear" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
            @foreach (var f in Model.FiscalYears)
            {
                <option value="@f" selected="@(f == fy)">@f</option>
            }
        </select>
    </form>
</div>

<partial name="_ReportHeader" />

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="kpi-card kpi-primary"><div class="kpi-label"><i class="bi bi-cash-stack me-1"></i>Total Expenditure</div><div class="kpi-value text-primary">Rs @Model.TotalExpenditure.ToString("N2")</div></div></div>
    <div class="col-md-4"><div class="kpi-card kpi-success"><div class="kpi-label"><i class="bi bi-receipt me-1"></i>Total VAT Paid</div><div class="kpi-value text-success">Rs @Model.TotalVatPaid.ToString("N2")</div></div></div>
    <div class="col-md-4"><div class="kpi-card kpi-warning"><div class="kpi-label"><i class="bi bi-calculator me-1"></i>Taxable Amount</div><div class="kpi-value text-warning">Rs @Model.TotalTaxableAmount.ToString("N2")</div></div></div>
    <div class="col-md-4"><div class="kpi-card kpi-info"><div class="kpi-label"><i class="bi bi-file-text me-1"></i>Total Invoices</div><div class="kpi-value text-info">@Model.TotalInvoices</div></div></div>
    <div class="col-md-4"><div class="kpi-card kpi-danger"><div class="kpi-label"><i class="bi bi-calendar-month me-1"></i>This Month</div><div class="kpi-value text-danger">Rs @Model.ThisMonthExpenses.ToString("N2")</div></div></div>
    <div class="col-md-4"><div class="kpi-card kpi-gray"><div class="kpi-label"><i class="bi bi-calendar-range me-1"></i>This Fiscal Year</div><div class="kpi-value text-secondary">Rs @Model.ThisFiscalYearExpenses.ToString("N2")</div></div></div>
</div>

<div class="row g-3">
    <div class="col-md-8"><div class="table-container"><h5><i class="bi bi-bar-chart-line text-primary"></i>Monthly Expenditure</h5><div id="monthlyChartSpinner" class="text-center py-5"><output class="spinner-border text-primary"><span class="visually-hidden">Loading...</span></output></div><div id="monthlyChartEmpty" class="d-none empty-state"><i class="bi bi-bar-chart-line"></i><h6>No data</h6><p>No expenses recorded for this period.</p></div><canvas id="monthlyChart" height="250" class="d-none"></canvas></div></div>
    <div class="col-md-4"><div class="table-container"><h5><i class="bi bi-pie-chart text-info"></i>By Category</h5><div id="categoryChartSpinner" class="text-center py-5"><output class="spinner-border text-info"><span class="visually-hidden">Loading...</span></output></div><div id="categoryChartEmpty" class="d-none empty-state"><i class="bi bi-pie-chart"></i><h6>No data</h6></div><canvas id="categoryChart" height="250" class="d-none"></canvas></div></div>
</div>
<div class="row g-3 mt-2">
    <div class="col-md-4"><div class="table-container"><h5><i class="bi bi-people text-success"></i>Top Suppliers</h5><div id="supplierChartSpinner" class="text-center py-5"><output class="spinner-border text-success"><span class="visually-hidden">Loading...</span></output></div><div id="supplierChartEmpty" class="d-none empty-state"><i class="bi bi-people"></i><h6>No data</h6></div><canvas id="supplierChart" height="250" class="d-none"></canvas></div></div>
    <div class="col-md-4"><div class="table-container"><h5><i class="bi bi-receipt text-warning"></i>VAT Paid</h5><div id="vatChartSpinner" class="text-center py-5"><output class="spinner-border text-warning"><span class="visually-hidden">Loading...</span></output></div><div id="vatChartEmpty" class="d-none empty-state"><i class="bi bi-receipt"></i><h6>No data</h6></div><canvas id="vatChart" height="250" class="d-none"></canvas></div></div>
    <div class="col-md-4"><div class="table-container"><h5><i class="bi bi-arrow-left-right text-secondary"></i>FY Comparison</h5><div id="fyChartSpinner" class="text-center py-5"><output class="spinner-border text-secondary"><span class="visually-hidden">Loading...</span></output></div><div id="fyChartEmpty" class="d-none empty-state"><i class="bi bi-arrow-left-right"></i><h6>No data</h6></div><canvas id="fyChart" height="250" class="d-none"></canvas></div></div>
</div>

@section Scripts {
    <script>
        var fiscalYear = '@(fy ?? "")';
    </script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
}
