@model List<ReportRowViewModel>
@{
    ViewData["Title"] = "Supplier-wise Report";
}

<partial name="_ReportHeader" />
@await Html.PartialAsync("_ReportView", new ReportPageViewModel
{
    Title = "Supplier-wise Report",
    ReportType = "SupplierWise",
    Rows = Model,
    Filters = ViewBag.Filter as ReportFilterViewModel
})
