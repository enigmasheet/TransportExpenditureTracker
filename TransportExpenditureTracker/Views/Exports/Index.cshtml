@model List<ExportQueueViewModel>
@{
    ViewData["Title"] = "Export Queue";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-download"></i> @ViewData["Title"]</h4>
    <small class="text-muted" id="last-refreshed"></small>
</div>

<div class="table-container" id="exports-container">
    @await Html.PartialAsync("_ExportTable", Model)
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#exports-table').DataTable({
                ordering: true,
                pageLength: 25,
                order: [[0, 'desc']],
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });

            function updateTimestamp() {
                var now = new Date();
                $('#last-refreshed').text('Last refreshed: ' + now.toLocaleTimeString());
            }
            updateTimestamp();

            setInterval(function () {
                $.get('@Url.Action("GetStatus")', function (html) {
                    var $newTable = $(html);
                    var newData = [];
                    $newTable.find('tbody tr').each(function () {
                        var row = [];
                        $(this).find('td').each(function () {
                            row.push($(this).html());
                        });
                        newData.push(row);
                    });
                    table.clear();
                    if (newData.length > 0) {
                        table.rows.add(newData);
                    }
                    table.draw();
                    updateTimestamp();
                });
            }, 15000);
        });
    </script>
}