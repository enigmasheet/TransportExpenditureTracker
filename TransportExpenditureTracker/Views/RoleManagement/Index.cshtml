@model List<UserRolesViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-shield-lock"></i> @ViewData["Title"]</h4>
</div>

<div class="table-container">
    <table class="table table-sm table-bordered" id="users-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Roles</th>
                <th style="width:150px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Roles.Count > 0)
                        {
                            @string.Join(", ", user.Roles)
                        }
                        else
                        {
                            <span class="text-muted">No roles</span>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#rolesModal"
                                data-id="@user.UserId" data-email="@user.Email">
                            <i class="bi bi-shield"></i> Manage Roles
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    Func<object, object> rolesBody = @<text>
        <div class="text-center py-3"><div class="spinner-border" role="status"></div></div>
    </text>;
}
@await Html.PartialAsync("_ModalForm", new ModalFormConfig
{
    ModalId = "rolesModal",
    FormId = "rolesForm",
    Title = "<i class='bi bi-shield-lock text-primary'></i> Manage Roles",
    BodyContent = rolesBody
})

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#users-table').DataTable({
                ordering: true,
                pageLength: 25,
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });

            ModalForm.initDynamic({
                modalId: 'rolesModal',
                formId: 'rolesForm',
                loadUrl: '@Url.Action("ManageRoles", "RoleManagement")',
                submitUrl: '@Url.Action("ManageRoles", "RoleManagement")',
                loadParamName: 'userId',
                useFormData: true
            });
        });
    </script>
}