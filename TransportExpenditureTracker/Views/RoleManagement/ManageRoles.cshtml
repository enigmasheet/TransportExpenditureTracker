@model List<ManageUserRolesViewModel>
@{
    var userId = ViewBag.UserId as string;
    var userEmail = ViewBag.UserEmail as string;
}

<input type="hidden" name="userId" value="@userId" />
<p class="mb-2"><strong>@userEmail</strong></p>
@for (int i = 0; i < Model.Count; i++)
{
    <div class="form-check mb-2">
        <input type="hidden" name="@($"[{i}].RoleName")" value="@Model[i].RoleName" />
        <input type="hidden" name="@($"[{i}].Selected")" value="false" />
        <input class="form-check-input" type="checkbox" name="@($"[{i}].Selected")" id="role_@i" value="true" @(Model[i].Selected ? "checked" : "") />
        <label class="form-check-label" for="role_@i">@Model[i].RoleName</label>
    </div>
}