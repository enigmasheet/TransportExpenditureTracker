@model ExpenseCategoryViewModel
@{
    ViewData["Title"] = "Delete Expense Category";
}

<h4 class="page-heading"><i class="bi bi-tags"></i> @ViewData["Title"]</h4>

<div class="delete-confirm d-flex align-items-center gap-3">
    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
    <div>
        <strong>Are you sure?</strong><br/>
        <span class="text-muted">This action cannot be undone. Existing expenses using this category will remain.</span>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Category Name</dt>
            <dd class="col-sm-8">@Model.CategoryName</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="CategoryId" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
        </form>
    </div>
</div>
