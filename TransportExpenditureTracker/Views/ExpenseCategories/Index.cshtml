@model List<ExpenseCategoryViewModel>
@{
    ViewData["Title"] = "Expense Categories";
}

<div class="section-title">
    <h4 class="page-heading"><i class="bi bi-tags"></i> @ViewData["Title"]</h4>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createCategoryModal"><i class="bi bi-plus-lg"></i> Add Category</button>
</div>

<div class="table-container">
    <table class="table table-sm table-bordered" id="categories-table">
        <thead>
            <tr>
                <th>Category Name</th>
                <th class="text-center">Expenses</th>
                <th style="width:120px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryName</td>
                    <td class="text-center">@item.ExpenseCount</td>
                    <td>
                        <button type="button" class="btn btn-outline-primary btn-icon" title="Edit" data-bs-toggle="modal" data-bs-target="#editCategoryModal" data-id="@item.CategoryId"><i class="bi bi-pencil"></i></button>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" class="btn btn-outline-danger btn-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal" data-id="@item.CategoryId"><i class="bi bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-tags"></i>
            <h6>No categories found</h6>
            <p>Add a category to get started.</p>
        </div>
    }
</div>

@{
    Func<object, object> createBody = @<text>@await Html.PartialAsync("~/Views/ExpenseCategories/_CategoryForm.cshtml", new ExpenseCategoryViewModel())</text>;
    Func<object, object> spinnerBody = @<text><div class="text-center py-3"><output class="spinner-border"></output></div></text>;
}
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "createCategoryModal", FormId = "createCategoryForm", Title = "<i class='bi bi-plus-lg text-primary'></i> Add Category", BodyContent = createBody })
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "editCategoryModal", FormId = "editCategoryForm", Title = "<i class='bi bi-pencil text-warning'></i> Edit Category", SubmitText = "Update", BodyContent = spinnerBody })
@await Html.PartialAsync("_ModalForm", new ModalFormConfig { ModalId = "deleteCategoryModal", FormId = "deleteCategoryForm", Title = "<i class='bi bi-trash text-danger'></i> Delete Category", SubmitText = "Delete", SubmitIcon = "bi-trash", SubmitClass = "btn-danger", BodyContent = spinnerBody })

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#categories-table').DataTable({
                ordering: true,
                pageLength: 25,
                language: { search: "<i class='bi bi-search'></i> _INPUT_", searchPlaceholder: "Search..." }
            });

            ModalForm.initCreate({
                modalId: 'createCategoryModal',
                formId: 'createCategoryForm',
                submitUrl: '@Url.Action("Create", "ExpenseCategories")'
            });

            ModalForm.initDynamic({
                modalId: 'editCategoryModal',
                formId: 'editCategoryForm',
                loadUrl: '@Url.Action("GetForEdit", "ExpenseCategories")',
                submitUrl: '@Url.Action("QuickUpdate", "ExpenseCategories")'
            });

            ModalForm.initDynamic({
                modalId: 'deleteCategoryModal',
                formId: 'deleteCategoryForm',
                loadUrl: '@Url.Action("GetDeleteInfo", "ExpenseCategories")',
                submitUrl: '@Url.Action("QuickDelete", "ExpenseCategories")'
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
